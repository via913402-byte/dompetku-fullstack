{
  "name": "dompetku-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix api && npm install --prefix web",
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm run dev --prefix web",
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
